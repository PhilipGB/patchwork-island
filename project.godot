; Engine configuration file.
; Patchwork Island — First Playable
; Godot 4.7.2 .NET / C#

config_version=5

[application]

config/name="Patchwork Island"
config/version="1.0.0"
config/description="A cheerful first-playable 3D village adventure for ages 5-10."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/icon="res://assets/icons/star.svg"

[dotnet]

project/assembly_name="PatchworkIsland"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

